{
  "name": "dsh-gitea",
  "version": "0.8.0",
  "private": true,
  "description": "Private deployment fork of the Gitea/Forgejo integration for DeepSeek Harness: 20+ issue/PR/worktree tools, settings page, and a real-time Git status chip.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "assets/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:leaks": "node scripts/leak-scan.mjs",
    "check": "npm test && npm run test:leaks && node --check lib/client.js && node --check lib/index.js",
    "dev:link": "node scripts/dev-link-dsh.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "gitea",
    "forgejo",
    "git",
    "worktrees",
    "deepseek-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://git.pvlb.dev/dsh-plugins/dsh-gitea.git"
  },
  "homepage": "https://git.pvlb.dev/dsh-plugins/dsh-gitea#readme",
  "bugs": {
    "url": "https://git.pvlb.dev/dsh-plugins/dsh-gitea/issues"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
